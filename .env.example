# Public installer URLs are baked into the static export at build time.
# Set these before npm run build. Hostinger URLs or public GitHub release
# asset URLs both work. Leave the optional MSI URL blank if unavailable.
NEXT_PUBLIC_MAC_DOWNLOAD_URL=https://sqlmate.io/downloads/SqlMate_0.4.1_x64.dmg
NEXT_PUBLIC_MAC_VERSION=0.4.1
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=https://sqlmate.io/downloads/SqlMate_0.6.0_x64-setup.exe
NEXT_PUBLIC_WINDOWS_MSI_URL=
NEXT_PUBLIC_WINDOWS_VERSION=0.6.0
